{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookclerk.dev/schemas/plugin-abi/v1/abi.json",
  "title": "BookclerkPluginAbi",
  "description": "Authoritative host↔plugin Workers RPC contract (api_version = 1). Generates Rust and TypeScript SDKs.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": 1 },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handshake": { "$ref": "#/$defs/HandshakeParams" },
        "shutdown": { "type": "null" },
        "health": { "type": "null" },
        "diagnose": { "type": "null" },
        "start": { "type": "null" },
        "onEvent": { "$ref": "#/$defs/HostToPluginEvent" },
        "pollEvents": { "type": "null" },
        "scanLibrary": { "$ref": "#/$defs/ScanLibraryParams" },
        "syncListening": { "type": "null" },
        "authenticateUser": { "$ref": "#/$defs/AuthenticateUserParams" },
        "cliDescribe": { "type": "null" },
        "cliInvoke": { "$ref": "#/$defs/CliInvokeParams" },
        "login": { "$ref": "#/$defs/LoginParams" },
        "loginStart": { "$ref": "#/$defs/LoginStartParams" },
        "loginComplete": { "$ref": "#/$defs/LoginCompleteParams" },
        "scan": { "$ref": "#/$defs/ScanParams" },
        "fetchTitle": { "$ref": "#/$defs/FetchTitleParams" },
        "searchCatalog": { "$ref": "#/$defs/SearchCatalogParams" },
        "expandCandidates": { "$ref": "#/$defs/ExpandCandidatesParams" },
        "purchaseHint": { "$ref": "#/$defs/PurchaseHintParams" },
        "listDeals": { "$ref": "#/$defs/ListDealsParams" },
        "put": { "$ref": "#/$defs/PutParams" },
        "putFile": { "$ref": "#/$defs/PutFileParams" },
        "get": { "$ref": "#/$defs/KeyParams" },
        "exists": { "$ref": "#/$defs/KeyParams" },
        "list": { "$ref": "#/$defs/ListParams" },
        "probe": { "$ref": "#/$defs/KeyParams" },
        "copy": { "$ref": "#/$defs/CopyParams" },
        "delete": { "$ref": "#/$defs/KeyParams" },
        "touchFile": { "$ref": "#/$defs/TouchFileParams" },
        "dbConnect": { "$ref": "#/$defs/DbConnectParams" },
        "dbPing": { "type": "null" },
        "dbQuery": { "$ref": "#/$defs/StatementDto" },
        "dbExecute": { "$ref": "#/$defs/StatementDto" }
      }
    }
  },
  "$defs": {
    "PluginError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_params",
            "unauthorized",
            "forbidden",
            "not_found",
            "unavailable",
            "unsupported",
            "internal"
          ]
        },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "HandshakeParams": {
      "type": "object",
      "required": ["apiVersion", "config"],
      "properties": {
        "apiVersion": { "const": 1 },
        "config": { "type": "object" }
      }
    },
    "HandshakeResult": {
      "type": "object",
      "required": ["apiVersion", "id", "kind", "capabilities"],
      "properties": {
        "apiVersion": { "const": 1 },
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["source", "integration", "output", "database"]
        },
        "displayName": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "object" },
        "configOptions": { "type": "array" },
        "cli": { "$ref": "#/$defs/CliSchema" },
        "portalAuthMode": { "type": "string", "enum": ["oauth", "password"] },
        "passwordEnvVar": { "type": "string" }
      }
    },
    "CliSchema": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "$ref": "#/$defs/CliCommandSpec" } }
      }
    },
    "CliCommandSpec": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "about": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/CliArgSpec" } }
      }
    },
    "CliArgSpec": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "long": { "type": "string" },
        "short": { "type": "string" },
        "kind": { "type": "string", "enum": ["string", "bool", "int", "path"] },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "about": { "type": "string" },
        "positional": { "type": "boolean" }
      }
    },
    "CliInvokeParams": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "object" }
      }
    },
    "HostToPluginEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "book_acquired" },
            "payload": {
              "type": "object",
              "required": ["titleId", "source", "pathKeys"],
              "properties": {
                "titleId": { "type": "string" },
                "source": { "type": "string" },
                "asin": { "type": "string" },
                "isbn": { "type": "string" },
                "pathKeys": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "library_scan_completed" },
            "payload": {
              "type": "object",
              "required": ["source", "upserted"],
              "properties": {
                "source": { "type": "string" },
                "upserted": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "config_changed" },
            "payload": {
              "type": "object",
              "required": ["config"],
              "properties": { "config": { "type": "object" } }
            }
          }
        }
      ]
    },
    "PluginToHostEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "external_users" },
            "payload": {
              "type": "object",
              "required": ["users"],
              "properties": { "users": { "type": "array" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "listening_progress" },
            "payload": {
              "type": "object",
              "required": ["items"],
              "properties": { "items": { "type": "array" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "plugin_log" },
            "payload": {
              "type": "object",
              "required": ["level", "message"],
              "properties": {
                "level": {
                  "type": "string",
                  "enum": ["debug", "info", "warn", "error"]
                },
                "message": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "ScanLibraryParams": { "type": "object" },
    "AuthenticateUserParams": { "type": "object" },
    "LoginParams": { "type": "object" },
    "LoginStartParams": { "type": "object" },
    "LoginCompleteParams": { "type": "object" },
    "ScanParams": { "type": "object" },
    "FetchTitleParams": { "type": "object" },
    "SearchCatalogParams": { "type": "object" },
    "ExpandCandidatesParams": { "type": "object" },
    "PurchaseHintParams": { "type": "object" },
    "ListDealsParams": { "type": "object" },
    "PutParams": { "type": "object" },
    "PutFileParams": { "type": "object" },
    "KeyParams": { "type": "object" },
    "ListParams": { "type": "object" },
    "CopyParams": { "type": "object" },
    "TouchFileParams": { "type": "object" },
    "DbConnectParams": { "type": "object" },
    "StatementDto": { "type": "object" }
  }
}
