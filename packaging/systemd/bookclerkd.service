[Unit]
Description=Bookclerk audiobook daemon (service / hardened)
Documentation=https://github.com/fritz-fritz/bookclerk
After=network-online.target
Wants=network-online.target

# Service mode: systemd starts the process as bookclerk with a single ambient
# capability (CAP_CHOWN). No setuid-root binary, no in-process root stage.
# Tray/UI connects to the loopback API; enable lingering if needed:
#   loginctl enable-linger <user>

[Service]
Type=simple
User=bookclerk
Group=bookclerk
Environment=BOOKCLERK_FILES_DIR=/var/lib/bookclerk
Environment=BOOKCLERK_CONFIG=/var/lib/bookclerk/config.toml
Environment=BOOKCLERK_DAEMON_LISTEN=127.0.0.1:8787
# Who should own ~/Audiobooks after acquire (env overrides config.toml).
# Environment=BOOKCLERK_OUTPUT_OWNER=alice
ExecStart=/usr/local/bin/bookclerkd
Restart=on-failure
RestartSec=5

# Least privilege: only CAP_CHOWN, granted ambient so User= never starts as root.
# Prefer this over file capabilities (setcap) — those attach to the binary for
# every exec. Pair AmbientCapabilities with CapabilityBoundingSet.
AmbientCapabilities=CAP_CHOWN
CapabilityBoundingSet=CAP_CHOWN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bookclerk
# Add the owner's Audiobooks path, e.g.:
# ReadWritePaths=/var/lib/bookclerk /home/alice/Audiobooks
# Let bookclerk write the tree (owner can still manage via ACL or chown):
#   setfacl -m u:bookclerk:rwx /home/alice/Audiobooks
#   setfacl -d -m u:bookclerk:rwx /home/alice/Audiobooks
#
# Create the service account before enabling:
#   useradd --system --home /var/lib/bookclerk --shell /usr/sbin/nologin bookclerk
#   mkdir -p /var/lib/bookclerk && chown -R bookclerk:bookclerk /var/lib/bookclerk
#   install -o root -g root -m 755 bookclerkd /usr/local/bin/bookclerkd

[Install]
WantedBy=multi-user.target
