[Unit]
Description=Bookclerk audiobook daemon
Documentation=https://github.com/fritz-fritz/bookclerk
After=network-online.target
Wants=network-online.target

# System-wide unit: runs as bookclerk. Prefer the user unit
# (bookclerkd.user.service) when a tray/session companion should attach to the
# installing user's systemd --user instance; that path still drops to bookclerk.

[Service]
Type=simple
User=bookclerk
Group=bookclerk
Environment=BOOKCLERK_FILES_DIR=/var/lib/bookclerk
Environment=BOOKCLERK_CONFIG=/var/lib/bookclerk/config.toml
Environment=BOOKCLERK_DAEMON_LISTEN=127.0.0.1:8787
# Set to the installing login name so @user/Audiobooks resolves under their
# home and acquired files are chown'd to them (also: BOOKCLERK_OUTPUT_OWNER).
# Environment=BOOKCLERK_OUTPUT_OWNER=alice
ExecStart=/usr/local/bin/bookclerkd
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only (not true): allow explicit ReadWritePaths under home for @user media.
ProtectHome=read-only
ReadWritePaths=/var/lib/bookclerk
# Add the owner's Audiobooks path when using @user/Audiobooks, e.g.:
# ReadWritePaths=/var/lib/bookclerk /home/alice/Audiobooks
# Grant the bookclerk account write+ACL on that directory (install script):
#   setfacl -m u:bookclerk:rwx /home/alice/Audiobooks
#   setfacl -d -m u:bookclerk:rwx /home/alice/Audiobooks
#
# Create the service account before enabling:
#   useradd --system --home /var/lib/bookclerk --shell /usr/sbin/nologin bookclerk
#   mkdir -p /var/lib/bookclerk && chown -R bookclerk:bookclerk /var/lib/bookclerk

[Install]
WantedBy=multi-user.target
