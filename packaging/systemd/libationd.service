[Unit]
Description=Libation audiobook daemon
Documentation=https://github.com/fritz-fritz/libation-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=libation
Group=libation
Environment=LIBATION_FILES_DIR=/var/lib/libation
Environment=LIBATION_CONFIG=/var/lib/libation/config.toml
Environment=LIBATION_DAEMON_LISTEN=127.0.0.1:8787
# Relative storage.local.root resolves under LIBATION_FILES_DIR.
# Prefer an absolute Books path in config.toml if media lives elsewhere,
# and add that path to ReadWritePaths.
ExecStart=/usr/local/bin/libationd
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/libation
# Decrypt/encode/fixup/split are native Rust — no ffmpeg binary required.
# Widevine L3 CDMs auto-provision (Android auth); optional BYO .wvd under Accounts/.
# Set LIBATION_AUTH_PASSWORD or LoadCredential= + LIBATION_AUTH_PASSWORD_FILE so
# Accounts/*.auth OAuth tokens are encrypted at rest.

[Install]
WantedBy=multi-user.target
