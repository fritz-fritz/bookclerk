[Unit]
Description=Libation audiobook daemon
Documentation=https://github.com/fritz-fritz/libation-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=libation
Group=libation
Environment=LIBATION_FILES_DIR=/var/lib/libation
Environment=LIBATION_CONFIG=/var/lib/libation/config.toml
Environment=LIBATION_DAEMON_LISTEN=127.0.0.1:8787
ExecStart=/usr/local/bin/libationd
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/libation

[Install]
WantedBy=multi-user.target
