[Unit]
Description=Bookclerk audiobook daemon (user session)
Documentation=https://github.com/fritz-fritz/bookclerk
After=network-online.target
Wants=network-online.target

# Install into the *installing user's* systemd --user instance so the tray /
# session UI can attach, while the process still drops to the bookclerk uid
# (setuid-root helper or a privileged ExecStart wrapper). Capture the owner
# for @user/Audiobooks via BOOKCLERK_OUTPUT_OWNER.

[Service]
Type=simple
# Files dir under the installing user's XDG data home (override as needed).
Environment=BOOKCLERK_FILES_DIR=%h/.local/share/bookclerk
Environment=BOOKCLERK_CONFIG=%h/.local/share/bookclerk/config.toml
Environment=BOOKCLERK_DAEMON_LISTEN=127.0.0.1:8787
# Installing user — used for @user/Audiobooks ownership after privilege drop.
Environment=BOOKCLERK_OUTPUT_OWNER=%u
# bookclerkd must be able to drop to the bookclerk account (setuid-root
# binary, or replace ExecStart with: /usr/bin/sudo -u bookclerk … after
# granting the user limited sudo). Fail-closed if drop cannot complete.
ExecStart=/usr/local/bin/bookclerkd
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
# Allow writing acquired media under the owner's home (default @user/Audiobooks).
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bookclerk %h/Audiobooks

[Install]
WantedBy=default.target
