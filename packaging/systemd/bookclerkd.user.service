[Unit]
Description=Bookclerk audiobook daemon (session / user)
Documentation=https://github.com/fritz-fritz/bookclerk
After=network-online.target
Wants=network-online.target

# Session mode: runs as the login user in systemd --user (tray-friendly).
# No setuid helper, no capability grants — acquired files are naturally
# owned by %u. For dedicated bookclerk uid isolation, use the system unit
# (bookclerkd.service) with AmbientCapabilities=CAP_CHOWN instead.

[Service]
Type=simple
Environment=BOOKCLERK_FILES_DIR=%h/.local/share/bookclerk
Environment=BOOKCLERK_CONFIG=%h/.local/share/bookclerk/config.toml
Environment=BOOKCLERK_DAEMON_LISTEN=127.0.0.1:8787
Environment=BOOKCLERK_OUTPUT_OWNER=%u
# Plain binary (mode 755). Process uid = installing user.
ExecStart=/usr/local/bin/bookclerkd
Restart=on-failure
RestartSec=5
# Session mode never needs setuid/file caps.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bookclerk %h/Audiobooks

[Install]
WantedBy=default.target
