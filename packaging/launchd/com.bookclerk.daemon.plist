<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for bookclerkd. Starts as root so bookclerkd can drop with
  seteuid to `bookclerk` while keeping real uid 0 for chown of ~/Audiobooks
  to the installing user (set BOOKCLERK_OUTPUT_OWNER).

  Install:
    sudo dscl . -create /Users/bookclerk
    sudo dscl . -create /Users/bookclerk UniqueID 499
    sudo dscl . -create /Users/bookclerk PrimaryGroupID 499
    sudo dscl . -create /Users/bookclerk UserShell /usr/bin/false
    sudo dscl . -create /Users/bookclerk NFSHomeDirectory /var/lib/bookclerk
    sudo dscl . -create /Groups/bookclerk
    sudo dscl . -create /Groups/bookclerk PrimaryGroupID 499
    sudo mkdir -p /var/lib/bookclerk && sudo chown -R bookclerk:bookclerk /var/lib/bookclerk
    # Grant bookclerk write + ACL on the owner's Audiobooks, e.g.:
    #   chmod +a "user:bookclerk allow list,add_file,search,add_subdirectory,delete_child,file_inherit,directory_inherit" ~/Audiobooks
    # Edit BOOKCLERK_OUTPUT_OWNER below to the installing login name.
    sudo cp packaging/launchd/com.bookclerk.daemon.plist /Library/LaunchDaemons/
    sudo launchctl load -w /Library/LaunchDaemons/com.bookclerk.daemon.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bookclerk.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/bookclerkd</string>
  </array>
  <!-- Run as root; bookclerkd drops euid to bookclerk (real uid stays 0). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOOKCLERK_FILES_DIR</key>
    <string>/var/lib/bookclerk</string>
    <key>BOOKCLERK_CONFIG</key>
    <string>/var/lib/bookclerk/config.toml</string>
    <key>BOOKCLERK_DAEMON_LISTEN</key>
    <string>127.0.0.1:8787</string>
    <key>BOOKCLERK_OUTPUT_OWNER</key>
    <string>REPLACE_WITH_LOGIN</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/var/lib/bookclerk</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/lib/bookclerk/logs/bookclerkd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/var/lib/bookclerk/logs/bookclerkd.err.log</string>
</dict>
</plist>
